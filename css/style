/* ===== Theme colors: change them here and everything updates ===== */
:root {
  --bg: #0f1319;
  --panel: #0b0e13;
  --win: #1a2029;
  --title: #232b37;
  --line: #2f3947;
  --text: #d7dde6;
  --arch: #1793d1;   /* Arch blue */
  --green: #5fd38d;
}

* { box-sizing: border-box; }

html, body {
  margin: 0; height: 100%; overflow: hidden;
  background: var(--bg); color: var(--text);
  font-family: system-ui, "Segoe UI", sans-serif;
  user-select: none;
}

/* Full-screen layers: boot, login, session */
.screen { position: fixed; inset: 0; }

/* ----- Boot ----- */
#boot {
  background: #000; color: #cfd8e3; padding: 20px;
  font: 13px/1.5 monospace; white-space: pre; z-index: 300000; overflow: hidden;
}
#boot .ok { color: var(--green); }

/* ----- Login ----- */
#login {
  display: none; z-index: 200000;
  flex-direction: column; align-items: center; justify-content: center; gap: 12px;
  background: radial-gradient(circle at 50% 30%, #1b2d40, #0a0d12 70%);
}
.avatar {
  width: 84px; height: 84px; border-radius: 50%; background: var(--arch);
  color: #fff; font-size: 40px; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.uname { font-size: 20px; }
#login input, #login button { padding: 8px 12px; border-radius: 6px; border: 1px solid var(--line); font-size: 14px; }
#login input { background: var(--panel); color: var(--text); width: 230px; text-align: center; outline: none; }
#login button { background: var(--arch); color: #fff; border: 0; cursor: pointer; }

/* ----- Session wallpaper ----- */
#session { background: radial-gradient(circle at 70% 60%, #162637, var(--bg) 70%); }

/* ----- Top panel ----- */
#panel {
  position: absolute; top: 0; left: 0; right: 0; height: 32px; z-index: 1000000;
  background: var(--panel); border-bottom: 1px solid var(--line);
  display: flex; align-items: center; justify-content: space-between; padding: 0 8px;
}
#panel button {
  background: none; color: var(--text); border: 0; cursor: pointer;
  padding: 4px 10px; border-radius: 4px; font-size: 13px;
}
#panel button:hover { background: rgba(255,255,255,.1); }
#menuBtn { background: var(--arch) !important; color: #fff !important; font-weight: 600; }
#clock { font-size: 13px; font-variant-numeric: tabular-nums; }

#menu {
  display: none; position: absolute; top: 34px; left: 8px; width: 180px; z-index: 1000001;
  background: var(--win); border: 1px solid var(--line); border-radius: 6px; padding: 4px;
}
#menu div { padding: 8px 10px; border-radius: 4px; cursor: pointer; font-size: 14px; }
#menu div:hover { background: var(--arch); color: #fff; }

/* ----- Desktop and icons ----- */
#desktop { position: absolute; top: 32px; left: 0; right: 0; bottom: 0; }
.icon {
  position: absolute; left: 16px; width: 84px; padding: 6px; border-radius: 6px;
  text-align: center; font-size: 12px; cursor: pointer;
}
.icon:hover { background: rgba(255,255,255,.08); }
.icon b { display: block; font-size: 30px; margin-bottom: 4px; font-family: monospace; }

/* ----- Dock ----- */
#dock {
  position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%);
  display: flex; gap: 8px; padding: 8px 12px; z-index: 1000000;
  background: rgba(11,14,19,.85); border: 1px solid var(--line); border-radius: 14px;
}
#dock button {
  width: 46px; height: 46px; border-radius: 10px; border: 0; cursor: pointer;
  background: var(--title); color: var(--text); font-size: 22px; font-family: monospace;
}
#dock button:hover { background: var(--arch); color: #fff; }

/* ----- Windows ----- */
.window {
  position: absolute; width: 500px; height: 330px; min-width: 260px; min-height: 160px;
  background: var(--win); border: 1px solid var(--line); border-radius: 8px;
  display: flex; flex-direction: column; overflow: hidden;
  box-shadow: 0 12px 32px rgba(0,0,0,.55);
}
.titlebar {
  height: 30px; flex: none; background: var(--title); cursor: move;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 8px; font-size: 13px;
}
.close {
  width: 18px; height: 18px; border: 0; border-radius: 50%;
  background: #e5604f; color: #fff; font-size: 10px; cursor: pointer;
}
.content { flex: 1; overflow: auto; user-select: text; }
.resize { position: absolute; right: 0; bottom: 0; width: 16px; height: 16px; cursor: nwse-resize; }

/* ----- Terminal ----- */
.term { min-height: 100%; background: #0b0e13; padding: 8px; font: 13px/1.4 monospace; }
.term pre { margin: 0; white-space: pre-wrap; }
.term .row { display: flex; gap: 6px; }
.term input { flex: 1; background: transparent; border: 0; outline: 0; color: var(--text); font: inherit; }
.prompt { color: var(--green); }

/* ----- Text editor ----- */
.editor {
  display: block; width: 100%; height: 100%; resize: none; border: 0; outline: 0;
  background: #11151b; color: var(--text); padding: 10px; font: 14px/1.5 monospace;
}

/* ----- File manager ----- */
.fm { display: flex; height: 100%; }
.tree { width: 140px; flex: none; padding: 6px; border-right: 1px solid var(--line); }
.tree div { padding: 6px 8px; border-radius: 4px; cursor: pointer; font-size: 13px; }
.tree div:hover, .tree div.active { background: var(--arch); color: #fff; }
.files { flex: 1; padding: 6px; }
.files div { padding: 6px 8px; border-bottom: 1px solid var(--line); font-size: 13px; }

/* ----- Settings ----- */
.settings { padding: 16px; font-size: 14px; }
.settings label { display: block; margin: 12px 0 4px; }

